<?php

use Drupal\Core\Entity\EntityInterface;

/**
 * Implements hook_entity_validate().
 */
function practicasdromen_entity_validate(EntityInterface $entity) {

  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'evento') {

    $fecha_inicio = $entity->get('field_fecha_inicio')->value ?? NULL;
    $fecha_fin = $entity->get('field_fecha_fin')->value ?? NULL;

    if ($fecha_inicio && $fecha_fin) {

      $inicio = strtotime($fecha_inicio);
      $fin = strtotime($fecha_fin);
      $ahora = strtotime('now');

      if ($fin < $inicio) {
        $entity->get('field_fecha_fin')->addViolation('La fecha de fin no puede ser anterior a la fecha de inicio.');
      }

      if ($inicio < $ahora) {
        $entity->get('field_fecha_inicio')->addViolation('No se pueden crear eventos en el pasado.');
      }
    }
  }
}
